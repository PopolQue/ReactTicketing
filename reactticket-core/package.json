{
  "name": "reactticket-core",
  "version": "1.0.0",
  "description": "Core ticketing business logic",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "cp src/utils/jsQR.* dist/utils/ || true",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {},
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "~6.0.2"
  }
}
