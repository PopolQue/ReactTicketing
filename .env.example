# Supabase Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to source control.

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (for client-side/mobile auth)
SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Key (for server-side operations only)
# Keep this secure!
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# PostHog Configuration
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-project-token
VITE_PUBLIC_POSTHOG_HOST=https://app.posthog.com
VITE_PUBLIC_POSTHOG_ASSETS_HOST=https://app.posthog.com
